# TermoControl SCADA — Configuração do servidor
# ATENÇÃO: Não commite arquivos .env contendo segredos reais.

# Chave secreta para assinar os JWT (mínimo 32 caracteres aleatórios)
# Para gerar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Segredo compartilhado com o ESP32 (dispositivo de campo)
# O ESP32 envia ?device=true&secret=<DEVICE_SECRET> no handshake WS
# Deve ter pelo menos 32 caracteres.
DEVICE_SECRET=

# Usuário administrador inicial (criado automaticamente no primeiro boot se não existir)
ADMIN_USER=admin

# Hash bcrypt da senha. Para gerar: node -e "const b=require('bcryptjs'); console.log(b.hashSync('SUA_SENHA_SEGURA',10))"
# Troque em produção! O sistema recusa iniciar com o hash da senha 'admin123'.
ADMIN_PASS_HASH=

PORT=3000
